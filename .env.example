# Things API

API_KEY=your-api-key-here-must-be-at-least-32-characters-long
API_KEY_NEXT=optional-next-key-for-rotation

# Things MCP server (when running the MCP package separately).
# Must match API_KEY above; defaults to http://localhost:8000 if THINGS_API_URL is unset.
THINGS_API_KEY=your-api-key-here-must-be-at-least-32-characters-long
THINGS_API_URL=http://localhost:8000
THINGS_EMAIL=your-things-cloud-email@example.com
THINGS_PASSWORD=your-things-cloud-password
SYNC_INTERVAL_SECONDS=60  # Pull interval in seconds (0 to disable background sync)
ENABLE_SCHEDULER=true
SCHEDULER_LOCK_SECONDS=30
SCHEDULER_HEARTBEAT_SECONDS=10
MANUAL_SYNC_LOCK_SECONDS=120
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_BASE_SECONDS=0.25
SYNC_CIRCUIT_BREAKER_FAILURES=3
SYNC_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
READINESS_MAX_SYNC_ERRORS=5
READINESS_MAX_SYNC_STALENESS_SECONDS=0  # 0 = disabled; e.g. 300 = mark /ready degraded after 5min without successful sync
LOG_FORMAT=text
ENABLE_METRICS=false
DATABASE_URL=sqlite+aiosqlite:///./data/things.db
